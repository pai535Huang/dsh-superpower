{
  "name": "dsh-superpower",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin that registers the obra/superpowers skills globally and restores the session-start discipline",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./skills/*": "./skills/*"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node validate.mjs",
    "check": "npm test && npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "pai535Huang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pai535Huang/dsh-superpower.git"
  },
  "homepage": "https://github.com/pai535Huang/dsh-superpower#readme",
  "bugs": {
    "url": "https://github.com/pai535Huang/dsh-superpower/issues"
  }
}
